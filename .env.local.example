# Salon de Lumière - 環境変数サンプル
# 実値は .env.local にコピーして設定すること（.env.local はコミットしない）

# 公式LINE友だち追加URL（ダミー）
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@example

# 電話番号（tel: スキーム用。ハイフン無しで指定）
NEXT_PUBLIC_TEL=0312345678

# 表示用電話番号（人間可読フォーマット）
NEXT_PUBLIC_TEL_DISPLAY=03-1234-5678

# Google Maps 埋め込み用iframe src（差し替え可能なプレースホルダー）
NEXT_PUBLIC_MAP_EMBED_SRC=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3240.0!2d139.7124!3d35.6646!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0!2sOmotesando!5e0!3m2!1sja!2sjp!4v1700000000000

# サロン名（表示用）
NEXT_PUBLIC_SALON_NAME=Salon de Lumière
